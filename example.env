# Spanner & GCP Configuration
GOOGLE_SPANNER_DATABASE=okf-database
GOOGLE_SPANNER_INSTANCE=spanner-instance
GOOGLE_CLOUD_REGION=us-west1
GOOGLE_PROJECT=mygcproject

# Disable built-in Spanner client metric exporter to Cloud Monitoring (prevents missing instance_id error)
SPANNER_DISABLE_BUILTIN_METRICS=true

